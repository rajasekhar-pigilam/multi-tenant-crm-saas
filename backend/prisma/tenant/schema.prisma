generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

enum TenantUserRole {
  ADMIN
  MANAGER
  MEMBER
}

model User {
  id         Int            @id @default(autoincrement())
  email      String         @unique
  role       TenantUserRole @default(MEMBER)
  createdAt  DateTime       @default(now()) @map("created_at")

  @@map("users")
}

model Customer {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  phone      String?
  company    String?
  createdAt  DateTime   @default(now()) @map("created_at")
  deals      Deal[]
  activities Activity[]

  @@map("customers")
}

model Deal {
  id         Int       @id @default(autoincrement())
  title      String
  value      Decimal   @db.Decimal(12, 2)
  stage      String
  customerId Int       @map("customer_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("deals")
}

model Activity {
  id         Int       @id @default(autoincrement())
  type       String
  notes      String?
  customerId Int       @map("customer_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("activities")
}
