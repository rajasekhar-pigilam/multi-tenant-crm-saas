MASTER_DB_URL="postgresql://postgres:postgres@localhost:5432/crm_master_db?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1h"
PORT=3000
API_PREFIX="api"
CORS_ORIGIN="http://localhost:4200"

TENANT_ABC_DB_URL="postgresql://postgres:postgres@localhost:5432/crm_tenant_abc_db?schema=public"
TENANT_XYZ_DB_URL="postgresql://postgres:postgres@localhost:5432/crm_tenant_xyz_db?schema=public"
TENANT_DEMO_DB_URL="postgresql://postgres:postgres@localhost:5432/crm_tenant_demo_db?schema=public"

NEON_API_KEY="replace-with-neon-api-key"
NEON_PROJECT_ID="replace-with-neon-project-id"
NEON_DB_OWNER="neondb_owner"
TENANT_DB_TEMPLATE="crm_tenant_{slug}_db"

ATLAS_ENV="local"

# ── Atlas dev (scratch) database — used by `atlas migrate diff` to compute diffs ──
# Option A: Docker (requires Docker Desktop running locally)
ATLAS_DEV_DB_URL="docker://postgres/16/dev"
# Option B: A dedicated Neon dev branch (no Docker required)
# ATLAS_DEV_DB_URL="postgresql://user:pass@host/atlas_dev_db?sslmode=require"
# Option C: A dedicated local PostgreSQL database
# ATLAS_DEV_DB_URL="postgresql://postgres:postgres@localhost:5432/crm_atlas_dev_db"

# ── Neon dev branch (for testing migrations before production) ─────────────────
# Create a branch in the Neon Console → Branches → "Create Branch"
# Paste the connection string here:
# NEON_DEV_BRANCH_URL="postgresql://user:pass@host/branch_db?sslmode=require"

# ── Vercel production env vars (set in Vercel project → Settings → Environment Variables) ──
# MASTER_DB_URL=<your Neon pooler connection string>
# JWT_SECRET=<strong random secret>
# JWT_EXPIRES_IN=1h
# NEON_API_KEY=<your Neon API key>
# NEON_PROJECT_ID=<your Neon project ID>
# NEON_DB_OWNER=neondb_owner
# TENANT_DB_TEMPLATE=crm_tenant_{slug}_db
# CORS_ORIGIN=*  # or your Vercel frontend URL for tighter security
